# ==============================================================================
# .gitignore - RTM Portal & Website
# Mencegah file privat, kredensial, dependensi, dan cache terunggah ke publik
# ==============================================================================

# 1. Dependensi Node.js
node_modules/
/.pnp
.pnp.js

# 2. Variabel Lingkungan & Kredensial Sensitif (WAJIB DIRAHSIAKAN)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.cert
credentials.json
serviceAccountKey.json

# 3. Output Build & Bundling
dist/
dist-ssr/
build/
out/
.vite/
.cache/

# 4. Database Lokal & File Penyimpanan SQLite (Mengandung Data Pribadi & Hash Kata Sandi)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# 5. File Sistem Operasi (macOS & Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 6. Log & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Editor & IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Direktori Sementara, Sockets, & Cache Agen / Taste-Skill
.taste-skill/
.temp/
.tmp/
temp/
tmp/
coverage/
.eslintcache
.stylelintcache

# 9. Uploaded Media Assets (Aset dinamis yang diunggah pengguna)
public/assets/uploads/*
!public/assets/uploads/.gitkeep
