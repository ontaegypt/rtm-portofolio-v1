# Port Backend Server
PORT=3001
NODE_ENV=development

# Konfigurasi Supabase (Jika Menggunakan Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
