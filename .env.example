# ==============================================================================
# RTM Portal & Website - Environment Variables Configuration (Template)
# Salin file ini menjadi .env dan sesuaikan dengan kredensial Supabase Anda
# ==============================================================================

# 1. Konfigurasi Server
PORT=3001
NODE_ENV=development

# 2. Supabase Cloud Database Connection String (PostgreSQL)
# Ambil dari Supabase: Project Settings > Database > Connection string > URI
# Format Pooler (Port 6543) - Direkomendasikan untuk Vercel / Serverless:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Format Direct Connection (Port 5432) - Untuk migrasi struktur tabel:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 3. Supabase Project API & Kredensial
# Ambil dari Supabase: Project Settings > API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"
